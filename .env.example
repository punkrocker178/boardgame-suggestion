LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_BATCH_SIZE=200
EMBEDDING_MAX_RETRIES=5
EMBEDDING_REQUEST_DELAY_SECONDS=1
LOG_LEVEL=INFO
POSTGRES_USER=boardgame
POSTGRES_PASSWORD=boardgame
POSTGRES_DB=boardgame_suggestion
# Host tools (import scripts) against Compose Postgres:
DATABASE_URL=postgresql+psycopg://boardgame:boardgame@localhost:5434/boardgame_suggestion
BGG_API_TOKEN=
BGG_REQUEST_DELAY_SECONDS=5
BGG_BATCH_SIZE=20
